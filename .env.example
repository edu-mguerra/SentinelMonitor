# ==========================================
# SENTINEL MONITOR - Environment Variables
# ==========================================

# Database
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_secret
POSTGRES_DB=sentinel_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel_secret@localhost:5432/sentinel_db
DATABASE_SYNC_URL=postgresql://sentinel:sentinel_secret@localhost:5432/sentinel_db

# Security & JWT
# Para gerar uma chave segura em produção: openssl rand -hex 32
SECRET_KEY=dev_secret_key_change_me_to_a_secure_random_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
PROJECT_NAME="Sentinel Monitor"
API_V1_STR=/api/v1

# SMTP & Notificações por E-mail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=sua_senha_de_app
SMTP_TLS=true
EMAILS_FROM_EMAIL=seu_email@gmail.com
EMAILS_FROM_NAME="Sentinel Monitor"
